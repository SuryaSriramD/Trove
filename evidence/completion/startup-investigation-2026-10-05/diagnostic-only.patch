@@ -0,0 +1,5 @@
+package main
+import("os"; "fmt"; "time"; "sync")
+var startupTraceMu sync.Mutex
+func startupTrace(stage string) { if path:=os.Getenv("TROVE_STARTUP_TRACE"); path!="" { startupTraceMu.Lock(); defer startupTraceMu.Unlock(); f,e:=os.OpenFile(path,os.O_APPEND|os.O_CREATE|os.O_WRONLY,0600); if e==nil {defer f.Close();fmt.Fprintf(f,"%0.3f %s\n",float64(time.Since(processStarted).Microseconds())/1000,stage)} } }
+func (a *App) ShellDiagnostic(stage string) { if len(stage)<=100 {startupTrace(stage)} }
